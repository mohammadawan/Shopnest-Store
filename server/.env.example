# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For Local Development: mongodb://127.0.0.1:27017/shopnest
# For Atlas Cloud: mongodb+srv://username:password@cluster.mongodb.net/shopnest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopnest

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
